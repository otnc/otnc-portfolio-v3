---
import Window from '@/components/night/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { SITE_ORIGIN, accounts, profile, supports } from '@/data/profile';

// Generated by scripts/build-images.mjs.
const banners = [
	{ path: '/banners/otoneko-200x40.png', width: 200, height: 40 },
	{ path: '/banners/otoneko-88x31.png', width: 88, height: 31 },
];
const bannerHtml = (banner: (typeof banners)[number]) =>
	`<a href="${SITE_ORIGIN}/"><img src="${SITE_ORIGIN}${banner.path}" width="${banner.width}" height="${banner.height}" alt="${profile.nameLatin}"></a>`;
---

<Window title="links.html" class="window--left">
	<h2>アカウント</h2>
	<ul class="links">
		{
			accounts.map((account) => (
				<li>
					<a href={account.url} target="_blank" rel="noreferrer">
						<PixelIcon name={account.icon} />
						<span>{account.label}</span>
						<span class="muted links__handle">{account.handle}</span>
					</a>
				</li>
			))
		}
	</ul>
	<h2 class="links-heading">支援</h2>
	<ul class="links">
		{
			supports.map((support) => (
				<li>
					<a href={support.url} target="_blank" rel="noreferrer">
						<span>★ {support.label}</span>
					</a>
				</li>
			))
		}
	</ul>
	<h2 class="links-heading">相互リンク用バナー</h2>
	<p class="muted">直リンクして大丈夫です。</p>
	<ul class="banners">
		{
			banners.map((banner) => (
				<li>
					<img src={banner.path} width={banner.width} height={banner.height} alt={`${profile.nameLatin} のバナー (${banner.width}x${banner.height})`} />
					<code class="banner-code">{bannerHtml(banner)}</code>
				</li>
			))
		}
	</ul>
</Window>

<style>
	.links-heading {
		margin-top: 24px;
	}

	.links {
		display: grid;
		gap: 4px;
		margin-top: 8px;
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 8px;
		text-decoration: none;
	}

	.links a:hover,
	.links a:focus-visible {
		background: var(--moon);
		color: var(--ink);
	}

	.links a:hover .muted {
		color: var(--ink);
	}

	.links__handle {
		margin-left: auto;
	}

	.banners {
		display: grid;
		gap: 16px;
		margin-top: 8px;
	}

	.banners li {
		display: grid;
		gap: 8px;
	}

	.banners img {
		image-rendering: pixelated;
	}

	/* One click selects the whole snippet, ready to copy. */
	.banner-code {
		display: block;
		padding: 4px 8px;
		background: var(--ink);
		color: var(--muted);
		font-family: var(--font-body);
		overflow-wrap: anywhere;
		user-select: all;
	}

	@media (max-width: 640px) {
		.links__handle {
			display: none;
		}
	}
</style>
