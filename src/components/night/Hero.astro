---
import MoonReflection from '@/components/night/MoonReflection.astro';
import NightSky from '@/components/night/NightSky.astro';
import Window from '@/components/night/Window.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { accounts, profile } from '@/data/profile';
---

<header class="hero">
	<div class="sea" data-sea data-color-back="#070b22" data-color-front="#1c3a86"></div>
	<NightSky />
	<MoonReflection />
	<div class="hero__inner">
		<Window title="otoneko.png" class="avatar-window" flush>
			<div class="avatar" data-avatar data-src={profile.avatar}>
				<img src={profile.avatar} alt="" width="200" height="200" />
			</div>
		</Window>
		<h1>{profile.nameLatin}</h1>
		<p class="terminal">
			<span class="terminal__prompt" aria-hidden="true">&gt;</span>
			<span data-typewriter>{profile.tagline}</span><span class="caret" aria-hidden="true">_</span>
		</p>
		<ul class="hero__icons">
			{
				accounts.map((account) => (
					<li>
						<a class="icon-link" href={account.url} target="_blank" rel="noreferrer" aria-label={account.label}>
							<PixelIcon name={account.icon} />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	import { mountDitheredAvatar, mountSeaBackground } from '@/scripts/night-shaders';
	import { typewrite } from '@/scripts/typewriter';

	const sea = document.querySelector<HTMLElement>('[data-sea]');
	if (sea) mountSeaBackground(sea);

	const avatar = document.querySelector<HTMLElement>('[data-avatar]');
	if (avatar) {
		mountDitheredAvatar(avatar)
			.then(() => avatar.classList.add('is-dithered'))
			.catch(() => {
				// Keep the plain <img> fallback when WebGL or the image is unavailable.
			});
	}

	const typewriter = document.querySelector<HTMLElement>('[data-typewriter]');
	if (typewriter && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) typewrite(typewriter);
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 100vh;
		overflow: hidden;
		text-align: center;
	}

	.sea {
		position: absolute;
		inset: 0;
	}

	.hero__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 64px 16px 96px;
	}

	.hero :global(.avatar-window) {
		width: 240px;
		margin-bottom: 24px;
	}

	/* ShaderMount inserts its canvas at z-index -1, so keep it inside this box's stacking context. */
	.avatar {
		position: relative;
		isolation: isolate;
		width: 100%;
		aspect-ratio: 1;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.4);
	}

	.avatar.is-dithered img {
		visibility: hidden;
	}

	h1 {
		color: var(--moon);
		text-shadow:
			4px 4px 0 var(--ink),
			8px 8px 0 var(--sea-3);
	}

	.terminal {
		display: flex;
		gap: 8px;
		min-width: 18em;
		margin-top: 16px;
		padding: 0 16px;
		background: var(--ink);
		color: var(--moon);
		text-align: left;
		border: 4px solid var(--frame);
		border-image: var(--pixel-corner) 3 / 2 / 2 stretch;
	}

	.terminal__prompt {
		color: var(--cyan);
	}

	.caret {
		color: var(--cyan);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.hero__icons {
		display: flex;
		gap: 16px;
		margin-top: 24px;
	}

	.icon-link {
		display: block;
		transition: transform 0.15s steps(2);
	}

	.icon-link:hover,
	.icon-link:focus-visible {
		transform: translateY(-6px);
	}

	/* On phones the moon sits in the top-right corner, so start the content below it. */
	@media (max-width: 640px) {
		.hero {
			place-items: start center;
		}

		.hero__inner {
			padding-top: 120px;
		}

		.terminal {
			min-width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}
</style>
