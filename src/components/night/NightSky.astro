---
import { pixelPaths } from '@/lib/pixel-path';

interface Props {
	starCount?: number;
}

const { starCount = 70 } = Astro.props;

// Seeded so the sky looks the same on every render instead of reshuffling per request.
function createRandom(seed: number) {
	let state = seed;
	return () => {
		state = (state * 1664525 + 1013904223) % 4294967296;
		return state / 4294967296;
	};
}

const random = createRandom(20061102);
const stars = Array.from({ length: starCount }, () => ({
	x: random() * 100,
	y: random() * 100,
	size: random() < 0.15 ? 6 : 3,
	delay: random() * 4,
	duration: 2 + random() * 3,
}));

const moonSize = 24;
const moonRadius = 11.5;
const moonColors = ['#fff6d5', '#f5e3a0', '#e8d48a'];
const craters = new Set(['7,7', '8,7', '7,8', '8,8', '15,13', '16,13', '15,14', '9,16', '13,5']);
const moonRows = Array.from({ length: moonSize }, (_, y) =>
	Array.from({ length: moonSize }, (_, x) => {
		const distance = Math.hypot(x + 0.5 - moonSize / 2, y + 0.5 - moonSize / 2);
		if (distance > moonRadius) return '0';
		if (craters.has(`${x},${y}`)) return '3';
		return distance > moonRadius - 1.5 && x > 12 ? '2' : '1';
	}).join(''),
);
---

<div class="night-sky" aria-hidden="true">
	{
		stars.map((star) => (
			<span
				class="star"
				style={`left:${star.x.toFixed(1)}%;top:${star.y.toFixed(1)}%;--size:${star.size}px;--delay:${star.delay.toFixed(1)}s;--duration:${star.duration.toFixed(1)}s`}
			/>
		))
	}
	<span class="shooting-star"></span>
	<svg class="moon" viewBox="0 0 24 24" shape-rendering="crispEdges">
		{pixelPaths(moonRows, moonColors).map((path) => <path fill={path.fill} d={path.d} />)}
	</svg>
</div>

<style>
	.night-sky {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.star {
		position: absolute;
		width: var(--size);
		height: var(--size);
		background: var(--moon);
		animation: twinkle var(--duration) steps(1) var(--delay) infinite;
	}

	@keyframes twinkle {
		0%,
		100% {
			opacity: 1;
		}
		40% {
			opacity: 0.25;
		}
		70% {
			opacity: 0.7;
		}
	}

	.moon {
		position: absolute;
		top: 12%;
		right: var(--moon-right);
		width: calc(24 * var(--dot));
		height: calc(24 * var(--dot));
		filter: drop-shadow(0 0 24px #fff6d566);
	}

	.shooting-star {
		position: absolute;
		top: 10%;
		left: 20%;
		width: 63px;
		height: 3px;
		background: linear-gradient(90deg, transparent, var(--moon));
		opacity: 0;
		transform: rotate(-20deg);
		animation: shoot 9s steps(12) 3s infinite;
	}

	@keyframes shoot {
		0% {
			opacity: 0;
			translate: 0 0;
		}
		2% {
			opacity: 1;
		}
		8% {
			opacity: 0;
			translate: 360px 130px;
		}
		100% {
			opacity: 0;
			translate: 360px 130px;
		}
	}

	@media (max-width: 640px) {
		.moon {
			top: 24px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star,
		.shooting-star {
			animation: none;
		}
	}
</style>
