---
import Window from '@/components/night/Window.astro';
import { SITE_ORIGIN, mutualLinks, profile } from '@/data/profile';

// Generated by scripts/build-images.mjs.
// The thumbnail is shown at half size, which keeps its 6px dots square.
const ownBanners = [
	{ path: '/thumbnail.png', width: 1200, height: 630, displayWidth: 600 },
	{ path: '/banners/otoneko-200x40.png', width: 200, height: 40 },
	{ path: '/banners/otoneko-88x31.png', width: 88, height: 31 },
];
const bannerHtml = (banner: (typeof ownBanners)[number]) =>
	`<a href="${SITE_ORIGIN}/"><img src="${SITE_ORIGIN}${banner.path}" width="${banner.width}" height="${banner.height}" alt="${profile.nameLatin}"></a>`;
---

<Window title="mutual-links.txt" class="window--right">
	<h2>相互リンク</h2>
	{
		mutualLinks.length === 0 ? (
			<p class="muted">まだありません。</p>
		) : (
			<ul class="partners">
				{mutualLinks.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noreferrer">
							{link.banner ? (
								<img src={link.banner.src} width={link.banner.width} height={link.banner.height} alt={link.name} />
							) : (
								<span>{link.name}</span>
							)}
						</a>
					</li>
				))}
			</ul>
		)
	}

	<h3 class="own-heading">このサイトのバナー</h3>
	<p class="muted">直リンクして大丈夫です。</p>
	<ul class="banners">
		{
			ownBanners.map((banner) => (
				<li>
					<img
						src={banner.path}
						width={banner.displayWidth ?? banner.width}
						height={((banner.displayWidth ?? banner.width) / banner.width) * banner.height}
						alt={`${profile.nameLatin} のバナー (${banner.width}x${banner.height})`}
					/>
					<code class="banner-code">{bannerHtml(banner)}</code>
				</li>
			))
		}
	</ul>
</Window>

<style>
	.partners {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.partners img,
	.banners img {
		display: block;
		max-width: 100%;
		height: auto;
		image-rendering: pixelated;
	}

	.own-heading {
		margin-top: 24px;
	}

	.banners {
		display: grid;
		gap: 16px;
		margin-top: 8px;
	}

	.banners li {
		display: grid;
		gap: 8px;
	}

	/* One click selects the whole snippet, ready to copy. */
	.banner-code {
		display: block;
		padding: 4px 8px;
		background: var(--ink);
		color: var(--muted);
		font-family: var(--font-body);
		overflow-wrap: anywhere;
		user-select: all;
	}
</style>
