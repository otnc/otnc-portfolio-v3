---
import { demos } from '@/data/profile';

interface Props {
	title: string;
	slug?: string;
	htmlClass?: string;
}

const { title, slug, htmlClass } = Astro.props;
const current = demos.find((demo) => demo.slug === slug);
---

<!doctype html>
<html lang="ja" class={htmlClass}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<slot name="head" />
	</head>
	<body>
		<nav class="demo-bar" aria-label="デモ切り替え">
			<a href="/demo/">← デモ一覧</a>
			{
				current && (
					<span>
						{current.title}
						{current.usesTailwind && <em>Tailwind 使用</em>}
					</span>
				)
			}
			<span class="demo-bar__links">
				{
					demos.map((demo) => (
						<a href={`/demo/${demo.slug}/`} aria-current={demo.slug === slug ? 'page' : undefined}>
							{demo.title}
						</a>
					))
				}
			</span>
		</nav>
		<slot />
	</body>
</html>

<style is:global>
	.demo-bar {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		flex-wrap: wrap;
		gap: 4px 16px;
		align-items: center;
		padding: 6px 16px;
		background: #111;
		color: #eee;
		font: 13px/1.6 'DotGothic16', system-ui, sans-serif;
		border-bottom: 2px solid #eee;
	}

	.demo-bar a {
		color: #eee;
		text-decoration: none;
	}

	.demo-bar a:hover,
	.demo-bar a[aria-current='page'] {
		color: #ffd84d;
	}

	.demo-bar em {
		margin-left: 8px;
		padding: 0 6px;
		font-style: normal;
		background: #38bdf8;
		color: #111;
	}

	.demo-bar__links {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin-left: auto;
	}
</style>
