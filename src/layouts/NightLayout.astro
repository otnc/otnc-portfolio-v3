---
/**
 * Shared frame for the night-sea pages: <head>, global styles, the wavy band edges and the beach footer.
 * Pages put their sections in the default slot and their footer links in the `footer-links` slot.
 */
import '@/styles/pixelmplus.css';
import '@/styles/night.css';
import Shoreline from '@/components/night/Shoreline.astro';
import { SITE_ORIGIN, profile } from '@/data/profile';

interface Props {
	lang: string;
	title: string;
	description: string;
	/** Path of this page, used for the canonical URL. */
	path: string;
	skipLinkLabel?: string;
}

const { lang, title, description, path, skipLinkLabel = '本文へ' } = Astro.props;
const url = `${SITE_ORIGIN}${path}`;
const ogLocale: Record<string, string> = { ja: 'ja_JP', ca: 'ca_ES' };
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#070b22" />
		<link rel="canonical" href={url} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="otoneko.cat" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:locale" content={ogLocale[lang] ?? lang} />
		<meta property="og:image" content={`${SITE_ORIGIN}/ogp.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${profile.nameLatin} (${profile.name})`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content={profile.twitter} />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<link rel="preload" href="/fonts/pixelmplus/10-site.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">{skipLinkLabel}</a>

		<!-- Wavy edges over the body background's hard colour stops (30% / 55% / 80%). -->
		<div class="sea-edges" aria-hidden="true">
			<span class="pixel-edge" style="--edge-color:#0e1b45;top:calc(30% - 18px)"></span>
			<span class="pixel-edge pixel-edge--b" style="--edge-color:var(--sea-2);top:calc(55% - 18px)"></span>
			<span class="pixel-edge" style="--edge-color:#173070;top:calc(80% - 18px)"></span>
		</div>

		<div class="site">
			<slot />

			<footer class="footer">
				<Shoreline />
				<div class="footer__sand">
					<p>(c) {profile.nameLatin} ({profile.name})</p>
					<p class="footer__links"><slot name="footer-links" /></p>
				</div>
			</footer>
		</div>

		<script>
			import { pauseWhileOffscreen, setupReveal } from '@/scripts/reveal';

			setupReveal();
			pauseWhileOffscreen('.hero, .page, .footer');
		</script>
	</body>
</html>

<style>
	.sea-edges {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.footer {
		position: relative;
		margin-top: 64px;
	}

	.footer__sand {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
		padding: 16px 16px 48px;
		background: var(--sand);
		color: var(--muted);
	}

	.footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 16px;
	}

	.footer__sand :global(a) {
		color: var(--link);
	}
</style>
