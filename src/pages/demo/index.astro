---
export const prerender = true;
import { demos } from '@/data/profile';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>デザインデモ一覧 | 音猫｡</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main>
			<h1>音猫｡ポートフォリオ<br />ドットデザイン デモ一覧</h1>
			<p class="lead">
				同じプロフィール内容を、ライブラリごとに組んだ試作です。見比べて方向性を決めるために置いています。
			</p>
			<p class="lead"><a href="/demo/combined/">→ RetroUI + NES.css + 自作 の統合案</a> / <a href="/">→ 最新案 (月夜のネットサーフィン)</a></p>
			<ol class="demos">
				{
					demos.map((demo, index) => (
						<li>
							<a class="card" href={`/demo/${demo.slug}/`}>
								<span class="num">{String(index + 1).padStart(2, '0')}</span>
								<span class="body">
									<strong>{demo.title}</strong>
									<span>{demo.note}</span>
									<span class="tags">
										<span class:list={['tag', { 'tag--warn': demo.usesTailwind }]}>
											{demo.usesTailwind ? 'Tailwind 必須' : 'Tailwind 不要'}
										</span>
										<span class="tag">{demo.usesReact ? 'React 使用' : 'JS なし'}</span>
									</span>
								</span>
							</a>
							<a class="lib" href={demo.libraryUrl} target="_blank" rel="noreferrer">
								{demo.library} の公式サイト ↗
							</a>
						</li>
					))
				}
			</ol>
		</main>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		background: #f4f1e8;
		color: #1a1a2e;
		font-family: 'DotGothic16', system-ui, sans-serif;
		line-height: 1.8;
	}

	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 48px 16px 80px;
	}

	h1 {
		margin: 0 0 16px;
		font-size: clamp(26px, 5vw, 40px);
		line-height: 1.3;
	}

	.lead {
		margin: 0 0 40px;
	}

	.demos {
		display: grid;
		gap: 28px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: flex;
		gap: 16px;
		padding: 16px 20px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow:
			0 -4px 0 0 #1a1a2e,
			0 4px 0 0 #1a1a2e,
			-4px 0 0 0 #1a1a2e,
			4px 0 0 0 #1a1a2e,
			8px 8px 0 0 #1a1a2e;
		transition: transform 0.15s steps(2);
	}

	.card:hover,
	.card:focus-visible {
		transform: translate(-3px, -3px);
		background: #fff6c8;
	}

	.num {
		font-size: 28px;
		line-height: 1;
		color: #e0457b;
	}

	.body {
		display: grid;
		gap: 4px;
	}

	.body strong {
		font-size: 20px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag {
		padding: 0 8px;
		background: #1a1a2e;
		color: #f4f1e8;
		font-size: 13px;
	}

	.tag--warn {
		background: #e0457b;
	}

	.lib {
		display: inline-block;
		margin-top: 12px;
		color: #1a1a2e;
		font-size: 14px;
	}
</style>
