---
export const prerender = true;
import 'nes.css/css/nes.min.css';
import DemoLayout from '@/layouts/DemoLayout.astro';
import { accounts, altPersona, profile, supports, works } from '@/data/profile';
---

<DemoLayout title="NES.css デモ | 音猫｡" slug="nes-css">
	<main class="nes-demo">
		<section class="nes-container is-dark is-centered hero">
			<img class="nes-avatar is-rounded is-large avatar" src={profile.avatar} alt="" />
			<h1>{profile.name}</h1>
			<p>{profile.tagline}</p>
			<div class="icons">
				<a href={accounts[0].url} target="_blank" rel="noreferrer" aria-label="GitHub"><i class="nes-icon github is-medium"></i></a>
				<a href={accounts[1].url} target="_blank" rel="noreferrer" aria-label="Twitter"><i class="nes-icon twitter is-medium"></i></a>
			</div>
		</section>

		<section class="message-list">
			<div class="message -left">
				<i class="nes-octocat animate"></i>
				<div class="nes-balloon from-left">
					<p>{profile.bio}</p>
				</div>
			</div>
		</section>

		<section class="nes-container with-title">
			<p class="title">ステータス</p>
			<div class="badges">
				{profile.roles.map((role) => <span class="nes-text is-primary">♦ {role}</span>)}
			</div>
			<p>ネタ力</p>
			<progress class="nes-progress is-error" value="92" max="100"></progress>
			<p>OSS 経験値</p>
			<progress class="nes-progress is-warning" value="68" max="100"></progress>
		</section>

		<section class="nes-container with-title">
			<p class="title">さくひん</p>
			<div class="works">
				{
					works.map((work) => (
						<div class="nes-container is-rounded work">
							<p><span class="nes-text is-success">[{work.kind}]</span> {work.name}</p>
							<p class="desc">{work.description}</p>
							<a class="nes-btn is-primary" href={work.url} target="_blank" rel="noreferrer">ひらく</a>
							<a class="nes-btn" href={work.repo} target="_blank" rel="noreferrer">コード</a>
						</div>
					))
				}
			</div>
		</section>

		<section class="nes-container is-dark with-title warp">
			<p class="title">ワープ土管</p>
			<p>{altPersona.summary}</p>
			<a class="nes-btn is-warning" href={altPersona.twitter.url} target="_blank" rel="noreferrer">{altPersona.twitter.handle}</a>
			<a class="nes-btn is-success" href={altPersona.site.url} target="_blank" rel="noreferrer">{altPersona.site.label}</a>
		</section>

		<section class="two">
			<div class="nes-container with-title">
				<p class="title">アカウント</p>
				<ul class="nes-list is-disc">
					{accounts.map((account) => <li><a href={account.url} target="_blank" rel="noreferrer">{account.label}</a> {account.handle}</li>)}
				</ul>
			</div>
			<div class="nes-container with-title">
				<p class="title">しえん</p>
				<ul class="nes-list is-circle">
					{supports.map((support) => <li><a href={support.url} target="_blank" rel="noreferrer">{support.label}</a></li>)}
				</ul>
			</div>
		</section>
	</main>
</DemoLayout>

<style is:global>
	body {
		margin: 0;
		background: #fcfcfc;
		font-family: 'Press Start 2P', 'DotGothic16', system-ui, sans-serif;
		font-size: 14px;
	}

	.nes-demo {
		display: flex;
		flex-direction: column;
		gap: 32px;
		max-width: 860px;
		margin: 0 auto;
		padding: 40px 16px 64px;
		line-height: 1.8;
	}

	.nes-demo .hero h1 {
		margin: 16px 0;
		font-size: 28px;
	}

	.nes-demo .avatar {
		image-rendering: pixelated;
	}

	.nes-demo .icons {
		display: flex;
		justify-content: center;
		gap: 16px;
	}

	.nes-demo .message {
		display: flex;
		align-items: flex-end;
		gap: 24px;
	}

	.nes-demo .badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-bottom: 16px;
	}

	.nes-demo .works {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 24px;
	}

	.nes-demo .work .desc {
		font-family: 'DotGothic16', system-ui, sans-serif;
		font-size: 15px;
	}

	.nes-demo .warp a {
		margin: 8px 8px 0 0;
	}

	.nes-demo .two {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 24px;
	}
</style>
