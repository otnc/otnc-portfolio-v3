---
export const prerender = true;
import 'pixel-retroui/dist/fonts.css';
import '@/styles/retro.css';
import Octocat from '@/components/Octocat.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { DitheredAvatar, OceanBackground } from '@/components/demos/ShaderHero';
import { accounts, altPersona, profile, supports, works } from '@/data/profile';

---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>音猫｡ | otnc.dev</title>
		<meta name="description" content={profile.bio} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
	</head>
	<body>
		<nav class="draft-bar" aria-label="試作の案内">
			<span>統合案 (RetroUI + NES.css + 自作)</span>
			<a href="/demo/">デモ一覧へ</a>
		</nav>

		<header class="hero">
			<OceanBackground client:only="react" colorBack="#f6f3ee" colorFront="#e3cfe6" />
			<div class="hero__inner">
				<p class="px-bubble px-bubble--down">やあ、{profile.name}です!</p>
				<div class="px-frame avatar">
					<DitheredAvatar
						client:only="react"
						avatar={profile.avatar}
						colorBack="#1b1b1b"
						colorFront="#c381b5"
						colorHighlight="#fefcd0"
					/>
				</div>
				<h1>{profile.name}</h1>
				<p class="hero__reading">{profile.reading} / {profile.handle}</p>
				<p class="hero__tagline">{profile.tagline}<span class="caret" aria-hidden="true">_</span></p>
				<ul class="hero__icons">
					{
						accounts.slice(0, 3).map((account) => (
							<li>
								<a class="icon-link" href={account.url} target="_blank" rel="noreferrer">
									<PixelIcon name={account.icon} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</header>

		<main class="page">
			<section class="about">
				<Octocat />
				<div class="px-frame px-frame--cream about__body">
					<h2>じこしょうかい</h2>
					<p>{profile.bio}</p>
					<ul class="tags">
						{profile.roles.map((role) => <li class="px-tag">{role}</li>)}
					</ul>
					<h3>つかえる言語・技術</h3>
					<ul class="tags">
						{profile.skills.map((skill) => <li class="px-tag px-tag--plain">{skill}</li>)}
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title">さくひん</h2>
				<div class="works">
					{
						works.map((work) => (
							<article class="px-frame work">
								<p class="work__kind">{work.kind}</p>
								<h3>{work.name}</h3>
								<p class="work__desc">{work.description}</p>
								<div class="actions">
									<a class="px-button px-button--cream" href={work.url} target="_blank" rel="noreferrer">ひらく</a>
									<a class="px-button" href={work.repo} target="_blank" rel="noreferrer">コード</a>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section class="px-frame px-frame--purple warp">
				<div class="warp__pipe" aria-hidden="true"></div>
				<div>
					<p class="warp__label">ワープゾーン</p>
					<h2>もうひとりのわたし「{altPersona.name}」</h2>
					<p>{altPersona.summary}</p>
					<div class="actions">
						<a class="px-button px-button--cream" href={altPersona.twitter.url} target="_blank" rel="noreferrer">
							<PixelIcon name="twitter" scale={2} />
							{altPersona.twitter.handle}
						</a>
						<a class="px-button px-button--cream" href={altPersona.site.url} target="_blank" rel="noreferrer">
							{altPersona.site.label} へ →
						</a>
					</div>
				</div>
			</section>

			<section class="two">
				<div class="px-frame px-frame--cream">
					<h2>アカウント</h2>
					<ul class="links">
						{
							accounts.map((account) => (
								<li>
									<a href={account.url} target="_blank" rel="noreferrer">
										<PixelIcon name={account.icon} scale={2} />
										<span>{account.label}</span>
										<span class="muted">{account.handle}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="px-frame px-frame--cream">
					<h2>しえん</h2>
					<ul class="links">
						{
							supports.map((support) => (
								<li>
									<a href={support.url} target="_blank" rel="noreferrer">
										<span>▶ {support.label}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title">コミュニティ</h2>
				<ul class="community">
					{
						profile.communities.map((community) => (
							<li class="px-frame">
								{community.url ? (
									<a href={community.url} target="_blank" rel="noreferrer">{community.name}</a>
								) : (
									<span>{community.name}</span>
								)}
								<span class="muted">{community.role}</span>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer class="footer">
			<p>© {profile.name} / {profile.handle}</p>
		</footer>
	</body>
</html>
